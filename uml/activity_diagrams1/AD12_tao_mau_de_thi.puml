@startuml AD12_tao_mau_de_thi
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 250

|Giáo viên|
start
:Chọn Tạo mẫu đề thi mới;

|Hệ thống|
:Lấy danh mục môn học và loại câu hỏi từ hệ thống;
:Hiển thị form thiết lập mẫu đề;

|Giáo viên|
:Nhập tên mẫu, môn học, thời gian làm bài, tổng số câu;

repeat
    :Thêm phần thi mới;
    :Nhập tên phần, số câu, loại câu hỏi;
    :Cài tỉ lệ độ khó (dễ / trung bình / khó %);
    if (Cần lọc Bloom?) then (Có)
        :Chọn cấp độ Bloom cho phần thi này;
    else (Không)
    endif
    if (Chọn chủ đề cụ thể?) then (Có)
        :Chọn chủ đề / chương;
    else (Không)
    endif
repeat while (Thêm phần thi khác?) is (Có)

:Bấm Lưu mẫu đề;

|Hệ thống|
:Kiểm tra tổng số câu khớp và tỉ lệ độ khó = 100% mỗi phần;
if (Hợp lệ?) then (Không)
    :Hiển thị lỗi cấu hình;
    |Giáo viên|
    :Chỉnh sửa lại;
    detach
else (Có)
    |Hệ thống|
    :Lưu mẫu đề và các phần thi;
    :Hiển thị thông báo thành công;
endif
stop
@enduml