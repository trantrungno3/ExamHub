@startuml AD39_cham_bai_thi
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 250

|Hệ thống|
start
:Nhận sự kiện học sinh nộp bài;
:Lấy bài làm và snapshot đáp án đề thi;
:Chấm điểm tự động các câu trắc nghiệm;
:Tính tổng điểm phần trắc nghiệm;
:Lưu điểm tự động vào kết quả;

if (Đề có câu tự luận?) then (Có)
    :Cập nhật trạng thái = Chờ chấm tay;
    :Gửi thông báo đến Giáo viên;

    |Giáo viên|
    :Nhận thông báo và mở giao diện chấm tay;
    :Xem bài làm câu tự luận;
    repeat
        :Nhập điểm và nhận xét cho từng câu;
    repeat while (Còn câu tự luận?) is (Còn)
    :Xác nhận hoàn tất chấm;

    |Hệ thống|
    :Tính tổng điểm: tự động + thủ công;
else (Không)
endif

:Cập nhật trạng thái bài làm = Đã chấm;
:Lưu kết quả cuối vào cơ sở dữ liệu;
:Gửi thông báo điểm đến Học sinh;
stop
@enduml