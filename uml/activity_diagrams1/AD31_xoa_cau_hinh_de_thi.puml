@startuml AD31_xoa_cau_hinh_de_thi
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 250

|Giáo viên|
start
:Truy cập trang Cấu hình đề thi;
:Chọn cấu hình cần xoá;
:Bấm nút Xoá;

|Hệ thống|
:Kiểm tra cấu hình có đang được dùng
để sinh đề thi không;
if (Đang được sử dụng?) then (Có)
    :Hiển thị cảnh báo;
    |Giáo viên|
    if (Xác nhận xoá bắt buộc?) then (Không)
        :Huỷ thao tác;
        stop
    else (Có)
    endif
else (Không)
    |Giáo viên|
    |Hệ thống|
    :Hiển thị hộp thoại xác nhận xoá;
    |Giáo viên|
    :Xác nhận xoá;
endif

|Hệ thống|
:Xoá cấu hình đề thi khỏi cơ sở dữ liệu;
:Hiển thị thông báo xoá thành công;
:Cập nhật danh sách cấu hình;
stop
@enduml