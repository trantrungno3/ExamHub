@startuml AD41_chinh_sua_nguoi_dung
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 250

|Quản trị viên|
start
:Truy cập trang Quản lý người dùng;
:Chọn người dùng cần chỉnh sửa;
:Bấm nút Chỉnh sửa;

|Hệ thống|
:Hiển thị mẫu điền thông tin người dùng
với dữ liệu hiện tại;

|Quản trị viên|
:Cập nhật thông tin: họ tên, vai trò,
trạng thái tài khoản;
:Bấm Lưu;

|Hệ thống|
:Kiểm tra tính hợp lệ dữ liệu;
if (Dữ liệu hợp lệ?) then (Không)
    :Hiển thị thông báo lỗi;
    |Quản trị viên|
    :Chỉnh sửa lại thông tin;
    detach
else (Có)
    |Hệ thống|
    :Cập nhật thông tin người dùng vào CSDL;
    :Hiển thị thông báo cập nhật thành công;
endif
stop
@enduml