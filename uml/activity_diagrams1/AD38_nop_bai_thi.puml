@startuml AD38_nop_bai_thi
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 250

|Học sinh|
start
:Đang trong giao diện làm bài thi;

if (Hết giờ?) then (Có)
    |Hệ thống|
    :Tự động nộp bài;
    :Hiển thị thông báo hết giờ - đã nộp tự động;
else (Nộp chủ động)
    |Học sinh|
    :Bấm nút Nộp bài;
    |Hệ thống|
    :Hiển thị hộp thoại xác nhận nộp bài;
    |Học sinh|
    if (Xác nhận nộp?) then (Không)
        :Tiếp tục làm bài;
        stop
    else (Có)
    endif
endif

|Hệ thống|
:Lưu toàn bộ đáp án bài làm;
:Cập nhật trạng thái bài làm = Đã nộp;
:Kích hoạt quy trình chấm điểm tự động;
:Hiển thị thông báo nộp bài thành công;
stop
@enduml