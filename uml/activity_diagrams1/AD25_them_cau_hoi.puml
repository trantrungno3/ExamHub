@startuml AD25_them_cau_hoi
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 250

|Giáo viên|
start
:Truy cập trang Ngân hàng câu hỏi;
:Bấm nút Thêm câu hỏi;

|Hệ thống|
:Hiển thị mẫu điền thông tin câu hỏi;

|Giáo viên|
:Điền thông tin câu hỏi và các thông tin liên quan (TN / Tự luận, môn học,...);
:Nhập nội dung câu hỏi và đáp án;

if (Cần đính kèm ảnh?) then (Có)
    :Upload ảnh minh hoạ;
    |Hệ thống|
    :Lưu ảnh lên MinIO;
    |Giáo viên|
else (Không)
endif

:Bấm Lưu câu hỏi;

|Hệ thống|
:Kiểm tra tính hợp lệ dữ liệu;
if (Hợp lệ?) then (Không)
    :Hiển thị thông báo lỗi;
    |Giáo viên|
    :Bổ sung thông tin còn thiếu;
    detach
else (Có)
    |Hệ thống|
    :Lưu câu hỏi với trạng thái Chờ duyệt;
    :Hiển thị thông báo thêm thành công;
endif
stop
@enduml