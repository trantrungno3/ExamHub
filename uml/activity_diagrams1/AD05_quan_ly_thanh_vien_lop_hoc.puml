@startuml AD05_quan_ly_thanh_vien_lop_hoc
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 250

|Quản trị viên|
start
:Truy cập trang chi tiết lớp học;

|Hệ thống|
:Hiển thị danh sách học sinh và giáo viên hiện tại;

|Quản trị viên|
:Chọn thao tác;

if (Enroll học sinh?) then (Có)
    |Hệ thống|
    :Hiển thị danh sách học sinh chưa thuộc lớp;
    |Quản trị viên|
    :Chọn học sinh và xác nhận;
else (Không)
    if (Phân công giáo viên?) then (Có)
        |Hệ thống|
        :Hiển thị danh sách giáo viên và môn học;
        |Quản trị viên|
        :Chọn giáo viên, môn học và xác nhận;
    else (Cập nhật GVCN)
        |Hệ thống|
        :Hiển thị danh sách giáo viên;
        |Quản trị viên|
        :Chọn giáo viên chủ nhiệm và xác nhận;
    endif
endif

|Hệ thống|
:Kiểm tra tính hợp lệ (không trùng lặp, đúng vai trò);
if (Hợp lệ?) then (Không)
    :Hiển thị thông báo lỗi;
    stop
else (Có)
    :Lưu thông tin phân công vào cơ sở dữ liệu;
    :Hiển thị thông báo thành công;
    :Cập nhật danh sách lớp học;
endif
stop
@enduml