@startuml AD34_tao_de_thi
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 250

|Giáo viên|
start
:Truy cập trang Quản lý đề thi;
:Chọn cấu hình đề thi;
:Bấm Tạo đề thi;

|Hệ thống|
:Hiển thị mẫu điền thông tin đề thi;

|Giáo viên|
:Điền tên đề thi và thông tin bổ sung;
:Bấm Tạo;

|Hệ thống|
:Lấy pool câu hỏi theo cấu hình;
if (Pool đủ câu hỏi?) then (Không)
    :Hiển thị cảnh báo không đủ câu hỏi;
    |Giáo viên|
    :Bổ sung câu hỏi hoặc điều chỉnh cấu hình;
    stop
else (Có)
    |Hệ thống|
    :Thực hiện Stratified Sampling;
    :Thực hiện Fisher-Yates Shuffle;
    :Lưu snapshot câu hỏi;
    :Tạo đề thi với mã đề duy nhất;
    :Hiển thị thông báo tạo đề thành công;
    |Giáo viên|
    :Xem trước đề thi vừa tạo;
endif
stop
@enduml