@startuml AD37_lam_bai_thi
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 250

|Học sinh|
start
:Truy cập mục Đề thi của tôi;

|Hệ thống|
:Hiển thị danh sách đề thi được giao
kèm trạng thái và thời gian còn lại;

|Học sinh|
:Chọn đề thi và bấm Bắt đầu làm bài;

|Hệ thống|
:Kiểm tra điều kiện làm bài;
if (Đủ điều kiện?) then (Không)
    :Hiển thị thông báo không thể làm bài;
    stop
else (Có)
    :Tạo bài làm mới (trạng thái: Đang làm);
    :Hiển thị giao diện làm bài
    với đồng hồ đếm ngược;

    |Học sinh|
    repeat
        :Đọc câu hỏi và nhập đáp án;
        |Hệ thống|
        :Tự động lưu tạm bài làm (mỗi 30 giây);
        |Học sinh|
    repeat while (Còn câu hỏi và chưa nộp?) is (Có)
endif
stop
@enduml