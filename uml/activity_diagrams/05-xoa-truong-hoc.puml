@startuml
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontSize 15
    FontName DejaVu Sans
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #997404
    DiamondFontSize 14
    StartColor #000000
    EndColor #000000
    ArrowColor #336699
    ArrowFontSize 13
    ArrowFontName DejaVu Sans
    BarColor #336699
}
skinparam swimlane {
    BorderColor #336699
    TitleBackgroundColor #EEF4FF
    TitleFontStyle bold
    TitleFontSize 16
    TitleFontName DejaVu Sans
    Width 220
}
skinparam ActivityFontName DejaVu Sans
skinparam defaultFontName DejaVu Sans
skinparam maxMessageSize 160

|Quản trị viên|
start
:Truy cập mục Quản lý trường;
|Hệ thống|
:Hiển thị danh sách trường học;
|Quản trị viên|
:Chọn trường cần xoá và bấm Xoá;
|Hệ thống|
:Hiển thị hộp thoại xác nhận xoá;
|Quản trị viên|
if (Xác nhận xoá?) then (đồng ý)
  |Hệ thống|
  :Kiểm tra trường có khoá học hoặc lớp học liên kết;
  |Hệ thống|
  if (Đang được sử dụng?) then (có)
    :Hiển thị cảnh báo trường đang có\nkhoá học hoặc lớp học liên kết;
      |Quản trị viên|
    if (Xoá bắt buộc?) then (có)
      |Hệ thống|
      :Xoá trường học khỏi cơ sở dữ liệu;
      :Hiển thị thông báo xoá thành công và cập nhật danh sách;
      stop
    else (huỷ)
      |Quản trị viên|
      stop
    endif
  else (không)
    |Hệ thống|
    :Xoá trường học khỏi cơ sở dữ liệu;
    :Hiển thị thông báo xoá thành công và cập nhật danh sách;
    stop
  endif
else (huỷ)
  |Quản trị viên|
  stop
endif
@enduml
