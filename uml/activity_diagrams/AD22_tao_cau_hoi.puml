@startuml AD22_tao_cau_hoi
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 150

|Giáo viên|
start
:Chọn Tạo câu hỏi mới;

|Hệ thống|
:Hiển thị form tạo câu hỏi;

|Giáo viên|
:Chọn loại câu hỏi (TN 1 đáp án / TN nhiều đáp án / Tự luận);
:Nhập nội dung câu hỏi và đáp án;
:Chọn môn học, chủ đề, chương;
:Chọn cấp độ Bloom và mức độ khó;

if (Cần đính kèm ảnh?) then (Có)
    :Chọn file ảnh minh hoạ;
    |Hệ thống|
    :Upload ảnh lên MinIO;
    :Lưu URL ảnh vào câu hỏi;
    :Hiển thị ảnh xem trước;
    |Giáo viên|
else (Không)
endif

:Bấm Lưu câu hỏi;

|Hệ thống|
:Kiểm tra tính hợp lệ (nội dung, đáp án đúng, phân loại);
if (Hợp lệ?) then (Không)
    :Hiển thị thông báo lỗi;
    |Giáo viên|
    :Bổ sung thông tin còn thiếu;
    detach
else (Có)
    |Hệ thống|
    :Lưu câu hỏi với trạng thái Chờ duyệt;
    :Hiển thị thông báo tạo thành công;
endif
stop
@enduml