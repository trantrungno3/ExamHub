@startuml
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontSize 15
    FontName DejaVu Sans
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #997404
    DiamondFontSize 14
    StartColor #000000
    EndColor #000000
    ArrowColor #336699
    ArrowFontSize 13
    ArrowFontName DejaVu Sans
    BarColor #336699
}
skinparam swimlane {
    BorderColor #336699
    TitleBackgroundColor #EEF4FF
    TitleFontStyle bold
    TitleFontSize 16
    TitleFontName DejaVu Sans
    Width 220
}
skinparam ActivityFontName DejaVu Sans
skinparam defaultFontName DejaVu Sans
skinparam maxMessageSize 160

|Giáo viên|
start
:Truy cập mục Ngân hàng câu hỏi;
|Hệ thống|
:Hiển thị giao diện tìm kiếm với bộ lọc\n(Môn học, Chủ đề/Chương, Bloom, Độ khó,\nLoại câu hỏi, Trạng thái duyệt, Từ khoá);
|Giáo viên|
:Nhập từ khoá và/hoặc chọn bộ lọc;
:Bấm nút Tìm kiếm;
|Hệ thống|
:Truy vấn cơ sở dữ liệu theo tiêu chí đã chọn;
if (Có câu hỏi phù hợp?) then (có)
  :Hiển thị danh sách câu\nhỏi phù hợp kèm thông tin\ntóm tắt;
else (không)
  :Hiển thị thông báo\nKhông tìm thấy câu hỏi\nphù hợp;
endif
stop
@enduml
