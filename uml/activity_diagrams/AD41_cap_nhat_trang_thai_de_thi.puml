@startuml AD41_cap_nhat_trang_thai_de_thi
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 150

|Giáo viên|
start
:Truy cập trang Quản lý đề thi;

|Hệ thống|
:Hiển thị danh sách đề thi kèm trạng thái;

|Giáo viên|
:Chọn đề thi cần cập nhật trạng thái;
:Chọn trạng thái mới;

|Hệ thống|
:Kiểm tra tính hợp lệ của thay đổi trạng thái;
if (Thay đổi hợp lệ?) then (Không)
    :Hiển thị thông báo không thể chuyển trạng thái;
    stop
else (Có)
    :Lưu trạng thái mới vào cơ sở dữ liệu;
    :Hiển thị thông báo cập nhật thành công;
endif
stop
@enduml