@startuml AD31_xuat_va_xem_truoc_de_thi
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 150

|Giáo viên|
start
:Chọn đề thi và chọn thao tác;

if (Xem trước?) then (Có)
    |Hệ thống|
    :Lấy nội dung đề và snapshot;
    :Render HTML đề thi;
    :Hiển thị đề thi trên trình duyệt;
    |Giáo viên|
    :Xem và kiểm tra nội dung đề;
    stop
else (Không)
    if (Xuất PDF?) then (Có)
        |Hệ thống|
        :Lấy nội dung đề thi;
        :Render sang PDF;
        :Upload file PDF lên MinIO;
        :Lưu đường dẫn file vào cơ sở dữ liệu;
        :Trả về link tải PDF;
        |Giáo viên|
        :Tải file PDF về máy;
        stop
    else (Xuất Word)
        |Hệ thống|
        :Lấy nội dung đề thi;
        :Tạo file DOCX;
        :Upload file DOCX lên MinIO;
        :Lưu đường dẫn file vào cơ sở dữ liệu;
        :Trả về link tải Word;
        |Giáo viên|
        :Tải file Word về máy;
        stop
    endif
endif
@enduml