@startuml AD05_xoa_truong_hoc
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 150

|Quản trị viên|
start
:Truy cập mục Quản lý trường;

|Hệ thống|
:Hiển thị danh sách trường học;

|Quản trị viên|
:Chọn trường cần xoá;
:Bấm nút Xoá;

|Hệ thống|
:Hiển thị hộp thoại xác nhận xoá;

|Quản trị viên|
if (Xác nhận xoá?) then (Không)
    :Đóng hộp thoại;
    stop
else (Có)
endif

|Hệ thống|
:Kiểm tra trường có đang được sử dụng;
if (Đang được sử dụng?) then (Có)
    :Hiển thị cảnh báo trường có khoá học/lớp học liên kết;
    |Quản trị viên|
    if (Xác nhận xoá bắt buộc?) then (Không)
        stop
    else (Có)
    endif
    |Hệ thống|
endif
:Xoá trường học khỏi cơ sở dữ liệu;
:Hiển thị thông báo xoá thành công;
:Cập nhật danh sách trường;
stop
@enduml
