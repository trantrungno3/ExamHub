@startuml AD44_xoa_nguoi_dung
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 150

|Quản trị viên|
start
:Truy cập trang Quản lý người dùng;
:Chọn người dùng cần xoá;
:Bấm nút Xoá;

|Hệ thống|
:Kiểm tra người dùng có dữ liệu liên quan
(bài làm, đề thi) không;
if (Có dữ liệu liên quan?) then (Có)
    :Hiển thị cảnh báo;
    |Quản trị viên|
    if (Xác nhận xoá bắt buộc?) then (Không)
        :Huỷ thao tác;
        stop
    else (Có)
    endif
else (Không)
    |Quản trị viên|
    |Hệ thống|
    :Hiển thị hộp thoại xác nhận xoá;
    |Quản trị viên|
    :Xác nhận xoá;
endif

|Hệ thống|
:Xoá tài khoản người dùng khỏi CSDL;
:Hiển thị thông báo xoá thành công;
:Cập nhật danh sách người dùng;
stop
@enduml