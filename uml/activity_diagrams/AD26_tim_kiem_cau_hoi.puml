@startuml AD26_tim_kiem_cau_hoi
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 150

|Giáo viên|
start
:Truy cập mục Ngân hàng câu hỏi;

|Hệ thống|
:Hiển thị giao diện tìm kiếm với các bộ lọc;
note right
    Môn học, Chủ đề, Bloom,
    Độ khó, Loại, Trạng thái
end note

|Giáo viên|
:Nhập từ khoá và/hoặc chọn bộ lọc;
:Bấm Tìm kiếm;

|Hệ thống|
:Truy vấn cơ sở dữ liệu theo tiêu chí đã chọn;
if (Tìm thấy kết quả?) then (Không)
    :Hiển thị thông báo không tìm thấy câu hỏi phù hợp;
    |Giáo viên|
    :Điều chỉnh tiêu chí và thử lại;
    detach
else (Có)
    |Hệ thống|
    :Hiển thị danh sách câu hỏi kèm thông tin tóm tắt;
    |Giáo viên|
    if (Muốn thao tác với câu hỏi?) then (Có)
        :Chọn câu hỏi để xem chi tiết hoặc sửa/xoá;
    else (Không)
        stop
    endif
endif
stop
@enduml