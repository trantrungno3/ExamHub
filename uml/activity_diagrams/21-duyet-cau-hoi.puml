@startuml
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontSize 15
    FontName DejaVu Sans
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #997404
    DiamondFontSize 14
    StartColor #000000
    EndColor #000000
    ArrowColor #336699
    ArrowFontSize 13
    ArrowFontName DejaVu Sans
    BarColor #336699
}
skinparam swimlane {
    BorderColor #336699
    TitleBackgroundColor #EEF4FF
    TitleFontStyle bold
    TitleFontSize 16
    TitleFontName DejaVu Sans
    Width 220
}
skinparam ActivityFontName DejaVu Sans
skinparam defaultFontName DejaVu Sans
skinparam maxMessageSize 160

|Quản trị viên / Giáo viên|
start
:Truy cập mục Duyệt câu hỏi;
|Hệ thống|
:Hiển thị danh sách câu hỏi đang chờ duyệt;
|Quản trị viên / Giáo viên|
:Chọn một câu hỏi để xem xét;
|Hệ thống|
:Hiển thị nội dung câu hỏi, đáp án,\nphân loại Bloom và độ khó;
|Quản trị viên / Giáo viên|
if (Quyết định duyệt?) then (Phê duyệt)
  |Hệ thống|
  :Cập nhật trạng thái câu hỏi thành Đã duyệt;
else (Từ chối)
  |Quản trị viên / Giáo viên|
  :Nhập lý do từ chối;
  |Hệ thống|
  :Cập nhật trạng thái câu hỏi thành Từ chối kèm lý do;
endif
:Thông báo kết quả duyệt và cập nhật danh sách;
stop
@enduml
