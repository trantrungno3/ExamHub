@startuml AD01_dang_nhap
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 150

|Quản trị viên / Giáo viên / Học sinh|
start
:Truy cập trang đăng nhập;
:Nhập tên đăng nhập và mật khẩu;
:Bấm nút Đăng nhập;

|Hệ thống|
:Kiểm tra tính hợp lệ dữ liệu;
if (Dữ liệu hợp lệ?) then (Không)
    :Hiển thị lỗi validation;
    |Quản trị viên / Giáo viên / Học sinh|
    :Chỉnh sửa thông tin;
    detach
else (Có)
    |Hệ thống|
    :Gọi use case Xác thực JWT;
    if (Thông tin đăng nhập đúng?) then (Không)
        :Hiển thị thông báo sai tài khoản hoặc mật khẩu;
        |Quản trị viên / Giáo viên / Học sinh|
        :Thử lại hoặc quên mật khẩu;
        detach
    else (Có)
        |Hệ thống|
        :Gọi use case Kiểm tra phân quyền;
        :Ghi nhận thời gian đăng nhập;
        :Tạo JWT token và lưu vào client;
        if (Vai trò là Quản trị viên?) then (Có)
            :Chuyển hướng đến trang Quản trị viên;
        else (Không)
            if (Vai trò là Giáo viên?) then (Có)
                :Chuyển hướng đến trang Giáo viên;
            else (Không - Học sinh)
                :Chuyển hướng đến trang Học sinh;
            endif
        endif
    endif
endif
stop
@enduml