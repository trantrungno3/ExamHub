@startuml AD08_them_khoa_hoc
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 150

|Quản trị viên|
start
:Truy cập mục Quản lý khoá học;

|Hệ thống|
:Hiển thị danh sách khoá học hiện có;

|Quản trị viên|
:Bấm Tạo khoá học mới;

|Hệ thống|
:Hiển thị form nhập liệu\n(tên khoá học, năm học, số lớp, ký hiệu lớp);

|Quản trị viên|
:Điền đầy đủ thông tin khoá học;
:Bấm Lưu;

|Hệ thống|
:Kiểm tra tính hợp lệ dữ liệu;
if (Dữ liệu hợp lệ?) then (Không)
    :Hiển thị thông báo lỗi;
    |Quản trị viên|
    :Chỉnh sửa lại thông tin;
    detach
else (Có)
    |Hệ thống|
    :Lưu khoá học vào cơ sở dữ liệu;
    :Gọi use case Sinh lớp học tự động;
    :Sinh các lớp học theo cấu hình khoá học;
    :Hiển thị thông báo tạo thành công kèm danh sách lớp vừa sinh;
endif
stop
@enduml
