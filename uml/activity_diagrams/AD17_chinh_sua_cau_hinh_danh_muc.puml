@startuml AD17_chinh_sua_cau_hinh_danh_muc
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 150

|Quản trị viên|
start
:Truy cập trang Cấu hình danh mục;

|Hệ thống|
:Hiển thị danh sách danh mục hiện có;

|Quản trị viên|
:Chọn danh mục cần chỉnh sửa;
:Bấm nút Chỉnh sửa;

|Hệ thống|
:Hiển thị mẫu điền với dữ liệu hiện tại;

repeat
|Quản trị viên|
:Cập nhật thông tin danh mục;
:Bấm Lưu;

|Hệ thống|
:Kiểm tra tính hợp lệ dữ liệu;
backward: Hiển thị thông báo lỗi;
repeat while (Dữ liệu hợp lệ?) is (Không) not (Có)

:Cập nhật danh mục vào cơ sở dữ liệu;
:Hiển thị thông báo cập nhật thành công;
stop
@enduml
