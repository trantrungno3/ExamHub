@startuml
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontSize 15
    FontName DejaVu Sans
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #997404
    DiamondFontSize 14
    StartColor #000000
    EndColor #000000
    ArrowColor #336699
    ArrowFontSize 13
    ArrowFontName DejaVu Sans
    BarColor #336699
}
skinparam swimlane {
    BorderColor #336699
    TitleBackgroundColor #EEF4FF
    TitleFontStyle bold
    TitleFontSize 16
    TitleFontName DejaVu Sans
    Width 220
}
skinparam ActivityFontName DejaVu Sans
skinparam defaultFontName DejaVu Sans
skinparam maxMessageSize 160

|Giáo viên|
start
:Truy cập trang quản lý cấu hình đề thi;
|Hệ thống|
:Hiển thị danh sách cấu hình đề thi hiện có;
|Giáo viên|
:Chọn cấu hình cần xoá và bấm Xoá;
|Hệ thống|
:Hiển thị hộp thoại xác nhận xoá;
|Giáo viên|
if (Xác nhận xoá?) then (đồng ý)
  |Hệ thống|
  :Kiểm tra cấu hình có đang được sử dụng để sinh đề;
  if (Đang được sử dụng?) then (có)
    :Cảnh báo cấu hình đang được sử dụng trong đề thi đã sinh;
    |Giáo viên|
    if (Xoá bắt buộc?) then (có)
      |Hệ thống|
      :Xoá cấu hình đề thi khỏi cơ sở dữ liệu;
      :Hiển thị thông báo xoá thành công và cập nhật danh sách;
      stop
    else (huỷ)
      |Giáo viên|
      stop
    endif
  else (không)
    |Hệ thống|
    :Xoá cấu hình đề thi khỏi cơ sở dữ liệu;
    :Hiển thị thông báo xoá thành công và cập nhật danh sách;
    stop
  endif
else (huỷ)
  |Giáo viên|
  stop
endif
@enduml
