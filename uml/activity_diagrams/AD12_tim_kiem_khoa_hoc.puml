@startuml AD12_tim_kiem_khoa_hoc
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 150

|Quản trị viên|
start
:Truy cập mục Quản lý khoá học;

|Hệ thống|
:Hiển thị ô tìm kiếm với bộ lọc\n(tên khoá học, năm học);

|Quản trị viên|
:Nhập từ khoá và chọn bộ lọc;
:Bấm Tìm kiếm;

|Hệ thống|
:Truy vấn dữ liệu theo tiêu chí;
if (Tìm thấy kết quả?) then (Không)
    :Hiển thị thông báo không tìm thấy;
    |Quản trị viên|
    :Điều chỉnh tiêu chí và thử lại;
    detach
else (Có)
    |Hệ thống|
    :Hiển thị danh sách khoá học phù hợp;
endif
stop
@enduml
