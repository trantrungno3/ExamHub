@startuml
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontSize 15
    FontName DejaVu Sans
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #997404
    DiamondFontSize 14
    StartColor #000000
    EndColor #000000
    ArrowColor #336699
    ArrowFontSize 13
    ArrowFontName DejaVu Sans
    BarColor #336699
}
skinparam swimlane {
    BorderColor #336699
    TitleBackgroundColor #EEF4FF
    TitleFontStyle bold
    TitleFontSize 16
    TitleFontName DejaVu Sans
    Width 220
}
skinparam ActivityFontName DejaVu Sans
skinparam defaultFontName DejaVu Sans
skinparam maxMessageSize 160

|Quản trị viên|
start
:Truy cập mục Quản lý trường và bấm Thêm mới;
|Hệ thống|
:Hiển thị form nhập liệu\n(tên trường, mã trường, địa chỉ, liên hệ);
repeat
  |Quản trị viên|
  :Điền thông tin trường học;
  :Bấm nút Lưu;
  |Hệ thống|
  :Kiểm tra tính hợp lệ dữ liệu;
  backward:Hiển thị thông báo lỗi và yêu cầu nhập lại;
repeat while (Dữ liệu hợp lệ?) is (không hợp lệ) not (hợp lệ)
:Lưu thông tin trường học vào cơ sở dữ liệu;
:Hiển thị thông báo thêm thành công và cập nhật danh sách;
stop
@enduml
