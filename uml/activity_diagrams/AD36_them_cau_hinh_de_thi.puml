@startuml AD36_them_cau_hinh_de_thi
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 150

|Giáo viên|
start
:Truy cập trang Cấu hình đề thi;
:Bấm nút Thêm cấu hình;

|Hệ thống|
:Hiển thị mẫu điền thông tin cấu hình đề thi;

|Giáo viên|
:Điền tên cấu hình, môn học, tổng số câu,
thời gian làm bài, tỉ lệ độ khó;
:Bấm Lưu;

|Hệ thống|
:Kiểm tra tính hợp lệ dữ liệu;
if (Dữ liệu hợp lệ?) then (Không)
    :Hiển thị thông báo lỗi;
    |Giáo viên|
    :Chỉnh sửa lại thông tin;
    detach
else (Có)
    |Hệ thống|
    :Lưu cấu hình đề thi vào cơ sở dữ liệu;
    :Hiển thị thông báo thêm thành công;
endif
stop
@enduml