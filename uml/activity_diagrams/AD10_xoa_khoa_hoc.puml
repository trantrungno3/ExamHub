@startuml AD10_xoa_khoa_hoc
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontName "DejaVu Sans"
    FontSize 16
    DiamondBackgroundColor #FFF4CE
    DiamondBorderColor #CC8800
    DiamondFontName "DejaVu Sans"
    DiamondFontSize 15
    StartColor #1F3864
    EndColor #1F3864
    BarColor #336699
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 15
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCCC00
skinparam noteFontName "DejaVu Sans"
skinparam swimlaneBorderColor #336699
skinparam swimlaneFontName "DejaVu Sans"
skinparam swimlaneFontStyle bold
skinparam wrapWidth 150

|Quản trị viên|
start
:Truy cập mục Quản lý khoá học;

|Hệ thống|
:Hiển thị danh sách khoá học;

|Quản trị viên|
:Chọn khoá học cần xoá;
:Bấm Xoá;

|Hệ thống|
:Hiển thị hộp thoại xác nhận xoá;

|Quản trị viên|
if (Xác nhận xoá?) then (Không)
    :Đóng hộp thoại;
    stop
else (Có)
endif

|Hệ thống|
:Kiểm tra khoá học có lớp đang hoạt động;
if (Còn lớp đang hoạt động?) then (Có)
    :Hiển thị cảnh báo khoá học còn lớp đang hoạt động;
    |Quản trị viên|
    if (Xác nhận xoá bắt buộc?) then (Không)
        stop
    else (Có)
    endif
    |Hệ thống|
endif
:Xoá khoá học khỏi cơ sở dữ liệu;
:Hiển thị thông báo xoá thành công;
:Cập nhật danh sách khoá học;
stop
@enduml
