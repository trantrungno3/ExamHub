@startuml
skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontSize 15
    FontName DejaVu Sans
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #997404
    DiamondFontSize 14
    StartColor #000000
    EndColor #000000
    ArrowColor #336699
    ArrowFontSize 13
    ArrowFontName DejaVu Sans
    BarColor #336699
}
skinparam swimlane {
    BorderColor #336699
    TitleBackgroundColor #EEF4FF
    TitleFontStyle bold
    TitleFontSize 16
    TitleFontName DejaVu Sans
    Width 220
}
skinparam ActivityFontName DejaVu Sans
skinparam defaultFontName DejaVu Sans
skinparam maxMessageSize 160

|Giáo viên|
start
:Chọn đề thi và bấm\nXem trước hoặc Xuất đề;
|Hệ thống|
if (Lựa chọn?) then (Xem trước)
  :Hiển thị đề thi trực tiếp trên\ntrình duyệt với đầy đủ định dạng;
  stop
else (Xuất đề)
  if (Định dạng?) then (PDF)
    :Render đề thi ra file PDF\ntheo định dạng chuẩn;
  else (Word)
    :Tạo file DOCX với nội dung\nđề thi;
  endif
  :Tải file lên hệ thống lưu trữ MinIO\nvà lấy đường dẫn;
  :Trả về đường dẫn tải file cho Giáo viên;
  |Giáo viên|
  :Tải file về máy;
  stop
endif
@enduml
