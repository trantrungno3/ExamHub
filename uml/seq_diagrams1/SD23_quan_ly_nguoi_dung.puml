@startuml SD23_quan_ly_nguoi_dung
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #336699
    LifeLineBackgroundColor #EEF4FF
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 13
    ParticipantFontName Arial
    ActorBackgroundColor White
    ActorFontName Arial
    ActorFontSize 13
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname Arial

actor "Quản trị viên" as Admin
participant "Giao diện" as FE
participant "Dịch vụ Người dùng" as US
participant "Auth Service" as Auth
database "Cơ sở dữ liệu" as DB

Admin -> FE : Truy cập trang Quản lý người dùng
FE -> US : GET /api/users
US -> DB : Truy vấn danh sách người dùng
DB --> US : [{danh sách người dùng}]
US --> FE : Danh sách người dùng
FE --> Admin : Hiển thị danh sách người dùng

alt Thêm người dùng mới
    Admin -> FE : Chọn Thêm người dùng
    FE --> Admin : Hiển thị form: họ tên, email, tên đăng nhập, mật khẩu tạm, vai trò
    Admin -> FE : Điền thông tin và bấm Lưu
    FE -> US : POST /api/users\n{fullName, email, username, password, role}
    US -> US : Kiểm tra email và tên đăng nhập chưa tồn tại
    US -> Auth : Tạo hash mật khẩu
    Auth --> US : {passwordHash}
    US -> DB : INSERT tài khoản người dùng mới
    DB --> US : {userId}
    US --> FE : 201 Created
    FE --> Admin : Thông báo thêm người dùng thành công

else Chỉnh sửa thông tin người dùng
    Admin -> FE : Chọn người dùng cần sửa
    FE -> US : GET /api/users/{id}
    US -> DB : Lấy thông tin người dùng
    DB --> US : {thông tin người dùng}
    US --> FE : Dữ liệu hiện tại
    FE --> Admin : Hiển thị form chỉnh sửa
    Admin -> FE : Cập nhật họ tên, vai trò, trạng thái và bấm Lưu
    FE -> US : PUT /api/users/{id}\n{fullName, role, status}
    US -> DB : UPDATE thông tin người dùng
    DB --> US : OK
    US --> FE : 200 OK
    FE --> Admin : Thông báo cập nhật thành công

else Xoá người dùng
    Admin -> FE : Chọn người dùng cần xoá và xác nhận
    FE -> US : DELETE /api/users/{id}
    US -> DB : Kiểm tra dữ liệu liên quan (bài làm, đề thi)
    DB --> US : {relatedData}
    US -> DB : Xoá hoặc vô hiệu hoá tài khoản
    DB --> US : OK
    US --> FE : 200 OK
    FE --> Admin : Thông báo xoá thành công

else Xem chi tiết người dùng
    Admin -> FE : Chọn người dùng cần xem
    FE -> US : GET /api/users/{id}
    US -> DB : Lấy thông tin đầy đủ người dùng
    DB --> US : {họ tên, email, vai trò, trạng thái, lớp học}
    US --> FE : Chi tiết người dùng
    FE --> Admin : Hiển thị đầy đủ thông tin người dùng

else Tìm kiếm người dùng
    Admin -> FE : Nhập từ khoá và chọn bộ lọc (vai trò, trạng thái)
    Admin -> FE : Bấm Tìm kiếm
    FE -> US : GET /api/users?keyword={kw}&role={r}&status={s}
    US -> DB : Truy vấn người dùng theo tiêu chí
    DB --> US : [{kết quả tìm kiếm}]
    US --> FE : Danh sách người dùng phù hợp
    FE --> Admin : Hiển thị kết quả tìm kiếm
end

@enduml