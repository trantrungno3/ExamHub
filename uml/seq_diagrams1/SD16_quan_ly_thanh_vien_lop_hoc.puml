@startuml SD16_quan_ly_thanh_vien_lop_hoc
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #336699
    LifeLineBackgroundColor #EEF4FF
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 13
    ParticipantFontName Arial
    ActorBackgroundColor White
    ActorFontName Arial
    ActorFontSize 13
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname Arial

actor "Quản trị viên" as Admin
participant "Giao diện" as FE
participant "Dịch vụ Lớp học" as CLS
participant "Dịch vụ Thông báo" as NS
database "Cơ sở dữ liệu" as DB

Admin -> FE : Truy cập trang chi tiết lớp học
FE -> CLS : GET /api/classes/{id}/members
CLS -> DB : Lấy danh sách thành viên lớp
DB --> CLS : [{học sinh}, {giáo viên}]
CLS --> FE : Danh sách thành viên hiện tại
FE --> Admin : Hiển thị danh sách học sinh và giáo viên

alt Enroll học sinh vào lớp
    Admin -> FE : Chọn Enroll học sinh
    FE -> CLS : GET /api/students?notInClass={classId}
    CLS -> DB : Lấy học sinh chưa thuộc lớp
    DB --> CLS : [{danh sách học sinh}]
    CLS --> FE : Danh sách học sinh có thể enroll
    FE --> Admin : Hiển thị danh sách để chọn
    Admin -> FE : Chọn học sinh và xác nhận
    FE -> CLS : POST /api/classes/{id}/enroll\n{studentIds: [...]}
    CLS -> DB : INSERT bản ghi enroll
    DB --> CLS : OK
    CLS --> FE : 200 OK
    FE --> Admin : Thông báo enroll thành công

else Phân công giáo viên
    Admin -> FE : Chọn Phân công giáo viên
    FE -> CLS : GET /api/teachers
    CLS -> DB : Lấy danh sách giáo viên
    DB --> CLS : [{danh sách giáo viên}]
    CLS --> FE : Danh sách giáo viên và môn học
    FE --> Admin : Hiển thị để chọn
    Admin -> FE : Chọn giáo viên, môn học và xác nhận
    FE -> CLS : POST /api/classes/{id}/assign-teacher\n{teacherId, subjectId}
    CLS -> DB : INSERT phân công giáo viên
    DB --> CLS : OK
    CLS --> FE : 200 OK
    FE --> Admin : Thông báo phân công thành công

else Cập nhật Giáo ViênCN
    Admin -> FE : Chọn Cập nhật Giáo ViênCN
    Admin -> FE : Chọn giáo viên chủ nhiệm mới
    FE -> CLS : PATCH /api/classes/{id}/homeroom-teacher\n{teacherId}
    CLS -> DB : UPDATE giáo viên chủ nhiệm
    DB --> CLS : OK
    CLS --> FE : 200 OK
    FE --> Admin : Thông báo cập nhật Giáo ViênCN thành công
end

@enduml