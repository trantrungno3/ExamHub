@startuml SD15_quan_ly_khoa_hoc_lop_hoc
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #336699
    LifeLineBackgroundColor #EEF4FF
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 13
    ParticipantFontName Arial
    ActorBackgroundColor White
    ActorFontName Arial
    ActorFontSize 13
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname Arial

actor "Quản trị viên" as Admin
participant "Giao diện" as FE
participant "Dịch vụ Khoá học" as CS
participant "Dịch vụ Lớp học" as CLS
database "Cơ sở dữ liệu" as DB

Admin -> FE : Truy cập mục Quản lý khoá học
FE -> CS : GET /api/courses
CS -> DB : Truy vấn danh sách khoá học
DB --> CS : [{danh sách khoá học}]
CS --> FE : Danh sách khoá học
FE --> Admin : Hiển thị danh sách khoá học

Admin -> FE : Chọn Tạo khoá học mới
FE --> Admin : Hiển thị form: tên khoá, năm học, số lớp, ký hiệu lớp
Admin -> FE : Điền đầy đủ thông tin và bấm Lưu

FE -> CS : POST /api/courses\n{name, schoolYear, classCount, symbol}
CS -> CS : Kiểm tra tính hợp lệ dữ liệu
CS -> DB : INSERT khoá học mới
DB --> CS : {courseId}
CS -> CLS : Sinh lớp học tự động\n{courseId, classCount, symbol}
loop Mỗi lớp học
    CLS -> DB : INSERT lớp học {tên lớp, courseId}
    DB --> CLS : OK
end
CLS --> CS : [{danh sách lớp vừa tạo}]
CS --> FE : 201 Created + {courseId, classes[]}
FE --> Admin : Thông báo thành công kèm danh sách lớp vừa sinh

Admin -> FE : Xem danh sách lớp theo năm học
FE -> CLS : GET /api/classes?schoolYear={year}
CLS -> DB : Truy vấn lớp theo năm học
DB --> CLS : [{danh sách lớp}]
CLS --> FE : Danh sách lớp học
FE --> Admin : Hiển thị danh sách lớp học

@enduml