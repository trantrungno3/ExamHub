@startuml SD14_quan_ly_truong_hoc
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #336699
    LifeLineBackgroundColor #EEF4FF
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 13
    ParticipantFontName Arial
    ActorBackgroundColor White
    ActorFontName Arial
    ActorFontSize 13
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname Arial

actor "Quản trị viên" as Admin
participant "Giao diện" as FE
participant "Dịch vụ Trường" as TS
database "Cơ sở dữ liệu" as DB

Admin -> FE : Truy cập mục Quản lý trường
FE -> TS : GET /api/schools
TS -> DB : Truy vấn danh sách trường
DB --> TS : [{danh sách trường}]
TS --> FE : Danh sách trường học
FE --> Admin : Hiển thị danh sách trường

alt Thêm mới trường học
    Admin -> FE : Chọn Thêm mới
    FE --> Admin : Hiển thị form nhập liệu
    Admin -> FE : Điền tên trường, mã trường, địa chỉ, liên hệ
    Admin -> FE : Bấm Lưu
    FE -> TS : POST /api/schools\n{name, code, address, contact}
    TS -> TS : Kiểm tra tính hợp lệ dữ liệu
    TS -> DB : INSERT thông tin trường mới
    DB --> TS : OK
    TS --> FE : 201 Created
    FE --> Admin : Thông báo thêm thành công

else Chỉnh sửa thông tin trường
    Admin -> FE : Chọn trường cần sửa
    FE -> TS : GET /api/schools/{id}
    TS -> DB : Lấy chi tiết trường
    DB --> TS : {thông tin trường}
    TS --> FE : Dữ liệu hiện tại
    FE --> Admin : Hiển thị form chỉnh sửa
    Admin -> FE : Cập nhật thông tin và bấm Lưu
    FE -> TS : PUT /api/schools/{id}\n{updated data}
    TS -> DB : UPDATE thông tin trường
    DB --> TS : OK
    TS --> FE : 200 OK
    FE --> Admin : Thông báo cập nhật thành công
end

@enduml