@startuml SD01_dang_nhap
title SD01 - Đăng nhập hệ thống
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #336699
    LifeLineBackgroundColor #EEF4FF
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 13
    ParticipantFontName Arial
    ActorBackgroundColor White
    ActorFontName Arial
    ActorFontSize 13
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname Arial

actor "Người dùng\n(Quản trị viên/Giáo viên/Học sinh)" as User
participant "Giao diện" as FE
participant "Auth Service" as Auth
participant "JWT Service" as JWT
participant "Phân quyền" as Role
database "Cơ sở dữ liệu" as DB

User -> FE : Truy cập trang đăng nhập
FE --> User : Hiển thị form đăng nhập

User -> FE : Nhập tên đăng nhập + mật khẩu
User -> FE : Bấm nút Đăng nhập

FE -> FE : Kiểm tra dữ liệu phía client
note right of FE : Kiểm tra trường bắt buộc\nĐịnh dạng email hợp lệ

alt Dữ liệu không hợp lệ
    FE --> User : Hiển thị lỗi kiểm tra dữ liệu
else Dữ liệu hợp lệ
    FE -> Auth : POST /api/auth/login\n{username, password}
    Auth -> DB : Truy vấn thông tin tài khoản
    DB --> Auth : Trả về thông tin tài khoản

    alt Tài khoản không tồn tại hoặc sai mật khẩu
        Auth --> FE : 401 Unauthorized
        FE --> User : Thông báo sai tài khoản / mật khẩu
    else Xác thực thành công
        Auth -> JWT : Tạo JWT token\n{userId, role, expiry}
        JWT --> Auth : Trả về access token + refresh token
        Auth -> DB : Ghi nhận thời gian đăng nhập
        Auth --> FE : 200 OK + {accessToken, refreshToken, userInfo}
        FE -> Role : Kiểm tra phân quyền theo vai trò
        Role --> FE : Trả về danh sách quyền tương ứng
        FE -> FE : Lưu token vào localStorage
        FE --> User : Chuyển hướng đến trang tương ứng với quyền
    end
end

@enduml