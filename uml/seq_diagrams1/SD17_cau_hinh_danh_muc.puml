@startuml SD17_cau_hinh_danh_muc
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #336699
    LifeLineBackgroundColor #EEF4FF
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 13
    ParticipantFontName Arial
    ActorBackgroundColor White
    ActorFontName Arial
    ActorFontSize 13
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname Arial

actor "Quản trị viên" as Admin
participant "Giao diện" as FE
participant "Dịch vụ Danh mục" as CS
database "Cơ sở dữ liệu" as DB

Admin -> FE : Truy cập mục Cấu hình danh mục
FE --> Admin : Hiển thị các nhóm: Môn học, Chủ đề,\nĐộ khó, Loại câu hỏi, Bloom
Admin -> FE : Chọn nhóm danh mục cần quản lý
FE -> CS : GET /api/catalog/{type}
CS -> DB : Truy vấn danh mục theo loại
DB --> CS : [{danh sách mục}]
CS --> FE : Danh sách mục hiện có
FE --> Admin : Hiển thị danh sách

alt Thêm mới mục danh mục
    Admin -> FE : Nhập thông tin mục mới và bấm Lưu
    FE -> CS : POST /api/catalog/{type}\n{name, description}
    CS -> CS : Kiểm tra không trùng tên
    CS -> DB : INSERT mục danh mục mới
    DB --> CS : OK
    CS --> FE : 201 Created
    FE --> Admin : Thông báo thêm thành công

else Chỉnh sửa mục danh mục
    Admin -> FE : Chọn mục cần sửa, cập nhật và bấm Lưu
    FE -> CS : PUT /api/catalog/{type}/{id}\n{name, description}
    CS -> DB : UPDATE mục danh mục
    DB --> CS : OK
    CS --> FE : 200 OK
    FE --> Admin : Thông báo cập nhật thành công

else Vô hiệu hoá mục danh mục
    Admin -> FE : Chọn mục cần vô hiệu hoá và xác nhận
    FE -> CS : PATCH /api/catalog/{type}/{id}/disable
    CS -> DB : UPDATE trạng thái = vô hiệu
    DB --> CS : OK
    CS --> FE : 200 OK
    FE --> Admin : Thông báo vô hiệu hoá thành công
end

@enduml