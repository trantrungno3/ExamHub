@startuml SD04_duyet_cau_hoi
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #336699
    LifeLineBackgroundColor #EEF4FF
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 13
    ParticipantFontName Arial
    ActorBackgroundColor White
    ActorFontName Arial
    ActorFontSize 13
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname Arial

actor "Quản trị viên / Giáo viên" as Reviewer
participant "Giao diện" as FE
participant "Dịch vụ Câu hỏi" as QS
participant "Dịch vụ Thông báo" as NS
database "Cơ sở dữ liệu" as DB

Reviewer -> FE : Truy cập mục Duyệt câu hỏi
FE -> QS : GET /api/questions?status=CHỜ_DUYỆT
QS -> DB : Truy vấn câu hỏi chờ duyệt
DB --> QS : [{danh sách câu hỏi}]
QS --> FE : Danh sách câu hỏi chờ duyệt
FE --> Reviewer : Hiển thị danh sách câu hỏi

Reviewer -> FE : Chọn một câu hỏi để xem xét
FE -> QS : GET /api/questions/{id}
QS -> DB : Lấy chi tiết câu hỏi
DB --> QS : {chi tiết câu hỏi}
QS --> FE : Chi tiết câu hỏi
FE --> Reviewer : Hiển thị nội dung đầy đủ

alt Phê duyệt
    Reviewer -> FE : Bấm Phê duyệt
    FE -> QS : PATCH /api/questions/{id}/approve
    QS -> DB : Cập nhật trạng thái = ĐÃ DUYỆT
    DB --> QS : OK
    QS -> NS : Gửi thông báo đến người tạo câu hỏi
    NS --> QS : OK
    QS --> FE : 200 OK
    FE --> Reviewer : Thông báo phê duyệt thành công
else Từ chối
    Reviewer -> FE : Bấm Từ chối + nhập lý do
    FE -> QS : PATCH /api/questions/{id}/reject\n{reason: "..."}
    QS -> DB : Cập nhật trạng thái = TỪ CHỐI, lý do
    DB --> QS : OK
    QS -> NS : Gửi thông báo từ chối + lý do đến người tạo
    NS --> QS : OK
    QS --> FE : 200 OK
    FE --> Reviewer : Thông báo từ chối thành công
end

@enduml