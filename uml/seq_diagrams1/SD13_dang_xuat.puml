@startuml SD13_dang_xuat
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #336699
    LifeLineBackgroundColor #EEF4FF
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 13
    ParticipantFontName Arial
    ActorBackgroundColor White
    ActorFontName Arial
    ActorFontSize 13
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname Arial

actor "Người dùng\n(Quản trị viên/Giáo viên/Học sinh)" as User
participant "Giao diện" as FE
participant "Auth Service" as Auth
database "Cơ sở dữ liệu" as DB

User -> FE : Bấm nút Đăng xuất
FE -> FE : Hiển thị hộp thoại xác nhận

alt Người dùng xác nhận (Yes)
    FE -> Auth : POST /api/auth/logout
    Auth -> Auth : Vô hiệu hoá token JWT
    Auth -> DB : Xoá phiên làm việc
    DB --> Auth : OK
    Auth --> FE : 200 OK
    FE -> FE : Xoá token khỏi bộ nhớ client
    FE --> User : Chuyển đến trang đăng nhập
else Người dùng huỷ (No)
    FE --> User : Đóng hộp thoại, giữ nguyên trang
end

@enduml