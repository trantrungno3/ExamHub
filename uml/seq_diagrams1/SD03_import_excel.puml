@startuml SD03_import_excel
title SD03 - Import câu hỏi hàng loạt từ Excel
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #336699
    LifeLineBackgroundColor #EEF4FF
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 13
    ParticipantFontName Arial
    ActorBackgroundColor White
    ActorFontName Arial
    ActorFontSize 13
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname Arial

actor "Giáo viên" as Teacher
participant "Giao diện" as FE
participant "Dịch vụ Import" as IS
participant "Excel Parser" as Parser
participant "Dịch vụ Bloom" as Bloom
participant "Dịch vụ Câu hỏi" as QS
database "Cơ sở dữ liệu" as DB

Teacher -> FE : Chọn chức năng Import Excel
FE --> Teacher : Hiển thị trang import + nút tải file mẫu

opt Tải file mẫu
    Teacher -> FE : Bấm tải file mẫu
    FE --> Teacher : Download file mẫu Excel
end

Teacher -> FE : Upload file Excel đã điền
FE -> IS : POST /api/questions/import\n{file: .xlsx}

IS -> Parser : Gọi phân tích file Excel
Parser -> Parser : Đọc từng dòng dữ liệu
Parser -> Parser : Kiểm tra định dạng cột
Parser --> IS : Trả về [{dữ liệu câu hỏi}] + danh sách lỗi

IS -> IS : Kiểm tra hợp lệ từng câu hỏi
loop Mỗi câu hỏi hợp lệ
    IS -> Bloom : Phân loại Bloom và độ khó
    Bloom --> IS : Xác nhận phân loại
    IS -> QS : Tạo câu hỏi
    QS -> DB : Thêm câu hỏi trạng thái CHỜ DUYỆT
    DB --> QS : OK
    QS --> IS : questionId
end

IS --> FE : Báo cáo kết quả\n{thành công: N, lỗi: M, chi tiết lỗi: [...]}
FE --> Teacher : Hiển thị kết quả import chi tiết

@enduml