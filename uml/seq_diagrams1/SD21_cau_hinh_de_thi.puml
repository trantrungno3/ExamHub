@startuml SD21_cau_hinh_de_thi
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #336699
    LifeLineBackgroundColor #EEF4FF
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 13
    ParticipantFontName Arial
    ActorBackgroundColor White
    ActorFontName Arial
    ActorFontSize 13
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname Arial

actor "Giáo viên" as Teacher
participant "Giao diện" as FE
participant "Dịch vụ Cấu hình đề" as ECS
database "Cơ sở dữ liệu" as DB

Teacher -> FE : Truy cập mục Cấu hình đề thi
FE -> ECS : GET /api/exam-configs
ECS -> DB : Truy vấn danh sách cấu hình
DB --> ECS : [{danh sách cấu hình}]
ECS --> FE : Danh sách cấu hình đề thi
FE --> Teacher : Hiển thị danh sách

alt Thêm cấu hình mới
    Teacher -> FE : Chọn Thêm mới
    FE --> Teacher : Hiển thị form: tên, môn học, tổng câu, thời gian, tỉ lệ độ khó
    Teacher -> FE : Điền thông tin và bấm Lưu
    FE -> ECS : POST /api/exam-configs\n{name, subjectId, totalQuestions, duration, difficulty}
    ECS -> ECS : Kiểm tra tính hợp lệ dữ liệu
    ECS -> DB : INSERT cấu hình đề thi mới
    DB --> ECS : {configId}
    ECS --> FE : 201 Created
    FE --> Teacher : Thông báo thêm thành công

else Chỉnh sửa cấu hình
    Teacher -> FE : Chọn cấu hình cần sửa và bấm Sửa
    FE -> ECS : GET /api/exam-configs/{id}
    ECS -> DB : Lấy chi tiết cấu hình
    DB --> ECS : {cấu hình hiện tại}
    ECS --> FE : Dữ liệu cấu hình
    FE --> Teacher : Hiển thị form chỉnh sửa
    Teacher -> FE : Cập nhật và bấm Lưu
    FE -> ECS : PUT /api/exam-configs/{id}\n{updated data}
    ECS -> DB : UPDATE cấu hình đề thi
    DB --> ECS : OK
    ECS --> FE : 200 OK
    FE --> Teacher : Thông báo cập nhật thành công

else Xoá cấu hình
    Teacher -> FE : Chọn cấu hình cần xoá và xác nhận
    FE -> ECS : DELETE /api/exam-configs/{id}
    ECS -> DB : Xoá cấu hình đề thi
    DB --> ECS : OK
    ECS --> FE : 200 OK
    FE --> Teacher : Thông báo xoá thành công

else Tìm kiếm cấu hình
    Teacher -> FE : Nhập từ khoá và chọn bộ lọc
    FE -> ECS : GET /api/exam-configs?keyword={kw}&subject={s}
    ECS -> DB : Truy vấn theo tiêu chí
    DB --> ECS : [{kết quả tìm kiếm}]
    ECS --> FE : Danh sách cấu hình phù hợp
    FE --> Teacher : Hiển thị kết quả tìm kiếm
end

@enduml