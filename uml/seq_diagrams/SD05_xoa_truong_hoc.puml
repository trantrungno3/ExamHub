@startuml SD05_xoa_truong_hoc
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #336699
    LifeLineBackgroundColor #EEF4FF
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 14
    ParticipantFontName "DejaVu Sans"
    ActorBackgroundColor White
    ActorFontName "DejaVu Sans"
    ActorFontSize 14
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname "DejaVu Sans"

actor "Quản trị viên" as Admin
participant "Giao diện" as FE
participant "Hệ thống" as SYS

Admin -> FE : Chọn trường cần xoá
FE --> Admin : Hiển thị hộp thoại xác nhận xoá

alt Quản trị viên xác nhận xoá
    Admin -> FE : Xác nhận
    FE -> SYS : Yêu cầu xoá trường học
    SYS -> SYS : Kiểm tra trường có đang được sử dụng

    alt Đang được sử dụng
        SYS --> FE : Trả về cảnh báo đang được sử dụng
        FE --> Admin : Cảnh báo trường có khoá học/lớp học liên kết
    else Chưa được sử dụng
        SYS -> SYS : Xoá trường học
        SYS --> FE : Trả về kết quả xoá thành công
        FE --> Admin : Thông báo xoá thành công
        FE --> Admin : Cập nhật danh sách trường
    end
else Quản trị viên huỷ
    FE --> Admin : Đóng hộp thoại, giữ nguyên danh sách
end

@enduml
