@startuml SD44_xoa_nguoi_dung
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #336699
    LifeLineBackgroundColor #EEF4FF
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 14
    ParticipantFontName "DejaVu Sans"
    ActorBackgroundColor White
    ActorFontName "DejaVu Sans"
    ActorFontSize 14
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname "DejaVu Sans"

actor "Quản trị viên" as Admin
participant "Giao diện" as FE
participant "Hệ thống" as SYS

Admin -> FE : Chọn người dùng cần xoá
FE --> Admin : Hiển thị hộp thoại xác nhận xoá

alt Quản trị viên xác nhận xoá
    Admin -> FE : Xác nhận
    FE -> SYS : Yêu cầu xoá người dùng
    SYS -> SYS : Kiểm tra người dùng có dữ liệu liên quan (bài làm, đề thi)

    alt Người dùng có dữ liệu liên quan
        SYS --> FE : Trả về cảnh báo và yêu cầu xác nhận lần 2
        FE --> Admin : Cảnh báo người dùng có dữ liệu liên quan

        alt Quản trị viên xác nhận xoá bắt buộc
            Admin -> FE : Xác nhận xoá bắt buộc
            FE -> SYS : Yêu cầu xoá bắt buộc người dùng
            SYS -> SYS : Vô hiệu hoá hoặc xoá tài khoản và dữ liệu liên quan
            SYS --> FE : Trả về kết quả xoá thành công
            FE --> Admin : Thông báo xoá thành công
        else Quản trị viên huỷ
            FE --> Admin : Huỷ thao tác, giữ nguyên tài khoản
        end
    else Người dùng chưa có dữ liệu liên quan
        SYS -> SYS : Xoá tài khoản người dùng
        SYS --> FE : Trả về kết quả xoá thành công
        FE --> Admin : Thông báo xoá thành công
    end
else Quản trị viên huỷ
    FE --> Admin : Đóng hộp thoại, giữ nguyên tài khoản
end

@enduml
