@startuml SD16_them_cau_hinh_danh_muc
autonumber
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #2E75B6
    LifeLineBackgroundColor #9DC3E6
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 14
    ParticipantFontName "DejaVu Sans"
    ActorBackgroundColor White
    ActorFontName "DejaVu Sans"
    ActorFontSize 14
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname "DejaVu Sans"
hide footbox

actor "Quản trị viên" as Admin
participant "Giao diện" as FE
participant "Hệ thống" as SYS

activate Admin
Admin -> FE ++ : Truy cập trang Cấu hình danh mục
FE -> SYS ++ : Yêu cầu danh sách danh mục
SYS -> SYS : Truy vấn danh sách danh mục
SYS --> FE -- : Trả về danh sách danh mục hiện có
FE --> Admin : Hiển thị danh sách danh mục

Admin -> FE : Bấm nút Thêm mới
FE --> Admin : Hiển thị mẫu điền thông tin danh mục

Admin -> FE : Điền tên danh mục và thông tin liên quan, bấm Lưu

FE -> SYS ++ : Yêu cầu thêm danh mục mới
SYS -> SYS : Kiểm tra tính hợp lệ và không trùng lặp

alt Dữ liệu hợp lệ
    SYS -> SYS : Lưu danh mục mới
    SYS --> FE : Trả về kết quả thêm thành công
    FE --> Admin : Thông báo thêm thành công
    FE --> Admin : Cập nhật danh sách danh mục
else Dữ liệu không hợp lệ
    SYS --> FE : Trả về lý do lỗi
    FE --> Admin : Hiển thị thông báo lỗi
    Admin -> FE : Chỉnh sửa lại thông tin
end
deactivate SYS
deactivate FE
deactivate Admin

@enduml
