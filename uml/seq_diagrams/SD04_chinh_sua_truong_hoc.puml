@startuml SD04_chinh_sua_truong_hoc
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #336699
    LifeLineBackgroundColor #EEF4FF
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 14
    ParticipantFontName "DejaVu Sans"
    ActorBackgroundColor White
    ActorFontName "DejaVu Sans"
    ActorFontSize 14
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname "DejaVu Sans"

actor "Quản trị viên" as Admin
participant "Giao diện" as FE
participant "Hệ thống" as SYS

Admin -> FE : Truy cập mục Quản lý trường
FE -> SYS : Yêu cầu danh sách trường học
SYS -> SYS : Truy vấn danh sách trường
SYS --> FE : Trả về danh sách trường học
FE --> Admin : Hiển thị danh sách

Admin -> FE : Chọn trường cần sửa và bấm Chỉnh sửa
FE -> SYS : Yêu cầu chi tiết trường
SYS -> SYS : Lấy chi tiết trường
SYS --> FE : Trả về dữ liệu hiện tại
FE --> Admin : Hiển thị form chỉnh sửa

Admin -> FE : Cập nhật thông tin
Admin -> FE : Bấm Lưu

FE -> SYS : Yêu cầu cập nhật trường học
SYS -> SYS : Kiểm tra tính hợp lệ dữ liệu

alt Dữ liệu hợp lệ
    SYS -> SYS : Cập nhật thông tin trường
    SYS --> FE : Trả về kết quả cập nhật thành công
    FE --> Admin : Thông báo cập nhật thành công
else Dữ liệu không hợp lệ
    SYS --> FE : Trả về lý do lỗi
    FE --> Admin : Hiển thị thông báo lỗi
end

@enduml
