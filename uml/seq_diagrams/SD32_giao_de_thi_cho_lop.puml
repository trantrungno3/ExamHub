@startuml SD32_giao_de_thi_cho_lop
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #336699
    LifeLineBackgroundColor #EEF4FF
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 14
    ParticipantFontName "DejaVu Sans"
    ActorBackgroundColor White
    ActorFontName "DejaVu Sans"
    ActorFontSize 14
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname "DejaVu Sans"

actor "Giáo viên" as Teacher
participant "Giao diện" as FE
participant "Hệ thống" as SYS

Teacher -> FE : Chọn đề thi và bấm Giao đề cho lớp
FE --> Teacher : Hiển thị form giao đề

Teacher -> FE : Chọn lớp học
Teacher -> FE : Đặt thời gian mở bài, đóng bài
Teacher -> FE : Đặt thời gian làm bài (phút)

opt Xem trước trước khi giao
    Teacher -> FE : Bấm xem trước đề
    FE --> Teacher : Hiển thị nội dung đề thi
end

Teacher -> FE : Bấm Xác nhận giao đề
FE -> SYS : Yêu cầu giao đề cho lớp đã chọn

SYS -> SYS : Kiểm tra thời gian hợp lệ
SYS -> SYS : Kiểm tra lớp tồn tại và giáo viên có quyền quản lý

alt Dữ liệu không hợp lệ
    SYS --> FE : Trả về chi tiết lỗi
    FE --> Teacher : Hiển thị thông báo lỗi
else Hợp lệ
    SYS -> SYS : Lưu bản ghi giao đề (đề thi, lớp, thời gian)
    SYS -> SYS : Lấy danh sách học sinh trong lớp
    SYS -> SYS : Gửi thông báo đến toàn bộ học sinh trong lớp
    SYS --> FE : Trả về kết quả giao đề thành công
    FE --> Teacher : Thông báo giao đề thành công
end

@enduml
