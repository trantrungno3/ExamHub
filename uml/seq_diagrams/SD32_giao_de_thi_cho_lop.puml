@startuml SD32_giao_de_thi_cho_lop
autonumber
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #2E75B6
    LifeLineBackgroundColor #9DC3E6
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 14
    ParticipantFontName "DejaVu Sans"
    ActorBackgroundColor White
    ActorFontName "DejaVu Sans"
    ActorFontSize 14
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname "DejaVu Sans"
hide footbox

actor "Giáo viên" as Teacher
participant "Giao diện" as FE
participant "Hệ thống" as SYS

activate Teacher
Teacher -> FE ++ : Chọn kỳ thi và bấm Giao kỳ cho lớp
FE --> Teacher : Hiển thị form giao kỳ

Teacher -> FE : Chọn lớp học, đặt thời gian mở bài, đóng bài, đặt thời gian làm bài (phút)

opt Xem trước trước khi giao
    Teacher -> FE : Bấm xem trước kỳ
    FE --> Teacher : Hiển thị nội dung kỳ thi
end

Teacher -> FE : Bấm Xác nhận giao kỳ
FE -> SYS ++ : Yêu cầu giao kỳ cho lớp đã chọn

SYS -> SYS : Kiểm tra thời gian hợp lệ, kiểm tra lớp tồn tại và giáo viên có quyền quản lý

alt Dữ liệu không hợp lệ
    SYS --> FE : Trả về chi tiết lỗi
    FE --> Teacher : Hiển thị thông báo lỗi
else Hợp lệ
    SYS -> SYS : Lưu bản ghi giao kỳ (kỳ thi, lớp, thời gian), lấy danh sách học sinh trong lớp, gửi thông báo đến toàn bộ học sinh trong lớp, trả về kết quả giao kỳ thành công
    FE --> Teacher : Thông báo giao kỳ thành công
end
deactivate SYS
deactivate FE
deactivate Teacher

@enduml
