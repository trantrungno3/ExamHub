@startuml SD11_xem_khoa_hoc_va_danh_sach_lop
autonumber
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #2E75B6
    LifeLineBackgroundColor #9DC3E6
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 14
    ParticipantFontName "DejaVu Sans"
    ActorBackgroundColor White
    ActorFontName "DejaVu Sans"
    ActorFontSize 14
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname "DejaVu Sans"
hide footbox

actor "Quản trị viên" as Admin
participant "Giao diện" as FE
participant "Hệ thống" as SYS

activate Admin
Admin -> FE ++ : Truy cập mục Quản lý khoá học
FE -> SYS ++ : Yêu cầu danh sách khoá học
SYS -> SYS : Truy vấn danh sách khoá học
SYS --> FE -- : Trả về danh sách khoá học
FE --> Admin : Hiển thị danh sách khoá học

Admin -> FE : Chọn khoá học cần xem
FE -> SYS ++ : Yêu cầu chi tiết khoá học và danh sách lớp
SYS -> SYS : Truy vấn thông tin chi tiết khoá học\nvà danh sách lớp thuộc khoá học
SYS --> FE -- : Trả về khoá học kèm danh sách lớp
FE --> Admin : Hiển thị đầy đủ thông tin khoá học\nkèm danh sách lớp theo năm học
deactivate FE
deactivate Admin

@enduml
