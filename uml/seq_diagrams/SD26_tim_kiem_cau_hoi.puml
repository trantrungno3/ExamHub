@startuml SD26_tim_kiem_cau_hoi
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #336699
    LifeLineBackgroundColor #EEF4FF
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 14
    ParticipantFontName "DejaVu Sans"
    ActorBackgroundColor White
    ActorFontName "DejaVu Sans"
    ActorFontSize 14
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname "DejaVu Sans"

actor "Giáo viên" as Teacher
participant "Giao diện" as FE
participant "Hệ thống" as SYS

Teacher -> FE : Truy cập mục Ngân hàng câu hỏi
FE --> Teacher : Hiển thị giao diện tìm kiếm với bộ lọc:\nMôn học, Chủ đề, Bloom, Độ khó, Loại, Trạng thái

Teacher -> FE : Nhập từ khoá và chọn bộ lọc
Teacher -> FE : Bấm Tìm kiếm

FE -> SYS : Yêu cầu tìm kiếm câu hỏi theo tiêu chí
SYS -> SYS : Truy vấn câu hỏi theo tiêu chí

alt Tìm thấy kết quả
    SYS --> FE : Trả về danh sách câu hỏi phù hợp
    FE --> Teacher : Hiển thị danh sách câu hỏi kèm thông tin tóm tắt

    opt Xem chi tiết câu hỏi
        Teacher -> FE : Chọn câu hỏi cần xem
        FE -> SYS : Yêu cầu chi tiết câu hỏi
        SYS --> FE : Trả về nội dung đầy đủ
        FE --> Teacher : Hiển thị nội dung, đáp án, Bloom, độ khó
    end

else Không tìm thấy kết quả
    SYS --> FE : Trả về danh sách rỗng
    FE --> Teacher : Thông báo không tìm thấy câu hỏi phù hợp
    Teacher -> FE : Điều chỉnh tiêu chí và tìm kiếm lại
end

@enduml
