@startuml SD39_tim_kiem_cau_hinh_de_thi
autonumber
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #2E75B6
    LifeLineBackgroundColor #9DC3E6
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 14
    ParticipantFontName "DejaVu Sans"
    ActorBackgroundColor White
    ActorFontName "DejaVu Sans"
    ActorFontSize 14
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname "DejaVu Sans"
hide footbox

actor "Giáo viên" as Teacher
participant "Giao diện" as FE
participant "Hệ thống" as SYS

activate Teacher
Teacher -> FE ++ : Truy cập trang Cấu hình đề thi
FE --> Teacher : Hiển thị ô tìm kiếm với bộ lọc: tên, môn học, trạng thái

Teacher -> FE : Nhập từ khoá và chọn điều kiện lọc, bấm Tìm kiếm

FE -> SYS ++ : Yêu cầu tìm kiếm cấu hình theo tiêu chí
SYS -> SYS : Truy vấn cấu hình theo tiêu chí

alt Tìm thấy kết quả
    SYS --> FE : Trả về danh sách cấu hình phù hợp
    FE --> Teacher : Hiển thị danh sách kết quả
else Không tìm thấy
    SYS --> FE : Trả về danh sách rỗng
    FE --> Teacher : Thông báo không tìm thấy cấu hình phù hợp
    Teacher -> FE : Điều chỉnh tiêu chí và tìm lại
end
deactivate SYS
deactivate FE
deactivate Teacher

@enduml
