@startuml SD45_tim_kiem_nguoi_dung
autonumber
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #2E75B6
    LifeLineBackgroundColor #9DC3E6
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 14
    ParticipantFontName "DejaVu Sans"
    ActorBackgroundColor White
    ActorFontName "DejaVu Sans"
    ActorFontSize 14
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname "DejaVu Sans"
hide footbox

actor "Quản trị viên" as Admin
participant "Giao diện" as FE
participant "Hệ thống" as SYS

activate Admin
Admin -> FE ++ : Truy cập trang Quản lý người dùng
FE --> Admin : Hiển thị ô tìm kiếm với bộ lọc:\nHọ tên, Email, Vai trò, Trạng thái

Admin -> FE : Nhập từ khoá và chọn điều kiện lọc, bấm Tìm kiếm

FE -> SYS ++ : Yêu cầu tìm kiếm người dùng theo tiêu chí
SYS -> SYS : Truy vấn người dùng theo tiêu chí

alt Tìm thấy người dùng phù hợp
    SYS --> FE : Trả về danh sách người dùng phù hợp
    FE --> Admin : Hiển thị danh sách kết quả kèm thông tin tóm tắt
else Không tìm thấy
    SYS --> FE : Trả về danh sách rỗng
    FE --> Admin : Thông báo không tìm thấy người dùng phù hợp
    Admin -> FE : Điều chỉnh tiêu chí và tìm lại
end
deactivate SYS
deactivate FE
deactivate Admin

@enduml
