@startuml SD41_them_nguoi_dung
autonumber
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 160
skinparam sequence {
    ArrowColor #2E75B6
    ActorBorderColor #333333
    LifeLineBorderColor #2E75B6
    LifeLineBackgroundColor #9DC3E6
    ParticipantBorderColor #336699
    ParticipantBackgroundColor #DDEEFF
    ParticipantFontSize 14
    ParticipantFontName "DejaVu Sans"
    ActorBackgroundColor White
    ActorFontName "DejaVu Sans"
    ActorFontSize 14
    NoteBackgroundColor #FFFFCC
    NoteBorderColor #CCCC00
}
skinparam fontname "DejaVu Sans"
hide footbox

actor "Quản trị viên" as Admin
participant "Giao diện" as FE
participant "Hệ thống" as SYS

activate Admin
Admin -> FE ++ : Truy cập trang Quản lý người dùng và bấm Thêm người dùng
FE --> Admin : Hiển thị form: họ tên, email, tên đăng nhập, mật khẩu tạm, vai trò

Admin -> FE : Điền đầy đủ thông tin người dùng, bấm Lưu

FE -> SYS ++ : Yêu cầu tạo tài khoản người dùng mới
SYS -> SYS : Kiểm tra email và tên đăng nhập chưa tồn tại

alt Email và tên đăng nhập hợp lệ
    SYS -> SYS : Tạo tài khoản người dùng mới với mật khẩu đã mã hoá
    SYS --> FE : Trả về kết quả thêm thành công
    FE --> Admin : Thông báo thêm người dùng thành công
else Email hoặc tên đăng nhập đã tồn tại
    SYS --> FE : Trả về lý do trùng lặp
    FE --> Admin : Hiển thị thông báo lỗi trùng lặp
    Admin -> FE : Chỉnh sửa thông tin và bấm lưu lại
end
deactivate SYS
deactivate FE
deactivate Admin

@enduml
